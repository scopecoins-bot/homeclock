# HomeClock server configuration.
# Copy to .env (or export in the systemd unit) — values below are safe examples.
# Never put real secrets in this file; it is committed to Git.

# Listen address. MUST stay loopback: exposure to the tailnet goes through
# Tailscale Serve only.
PORT=8788
HOST=127.0.0.1

# SQLite database location (created + migrated automatically).
DATABASE_PATH=./data/homeclock.db

# Somtoday MCP connector (existing install on bossp).
SOMTODAY_MCP_CMD=node
SOMTODAY_MCP_ARGS=/home/bossp/agent-stack/somtoday-mcp/dist/index.js
SOMTODAY_MCP_CWD=/home/bossp/agent-stack/somtoday-mcp

# Weather provider (open-meteo, no API key).
WEATHER_ENABLED=1

# log level: debug | info | warn | error
LOG_LEVEL=info
