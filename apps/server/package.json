{
  "name": "@homeclock/server",
  "version": "1.0.0",
  "private": true,
  "description": "HomeClock backend API (runs on bossp, tailnet-only via Tailscale Serve)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run --silent build --prefix ../../packages/shared && tsc -p tsconfig.json",
    "typecheck": "npm run --silent build --prefix ../../packages/shared && tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "pair": "npm run --silent build && node dist/scripts/pair.js",
    "pretest": "npm run --silent build && tsc -p tsconfig.tests.json",
    "test": "node --test --test-concurrency=1 \"dist-tests/test/**/*.test.js\""
  },
  "dependencies": {
    "@homeclock/shared": "file:../../packages/shared",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.8.0",
    "ws": "^8.18.0"
  }
}
