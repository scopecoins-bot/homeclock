{
  "expo": {
    "name": "HomeClock",
    "slug": "homeclock",
    "version": "1.0.0",
    "orientation": "all",
    "icon": "./assets/images/icon.png",
    "scheme": "homeclock",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "nl.krimson.homeclock",
      "supportsTablet": true,
      "requireFullScreen": true,
      "infoPlist": {
        "NSAlarmKitUsageDescription": "HomeClock gebruikt AlarmKit om je wekkers betrouwbaar te laten afgaan, ook als de app gesloten is.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1020",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1020",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "HomeClock gebruikt Face ID om je serverkoppeling veilig te bewaren."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#7FA8FF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    }
  }
}
